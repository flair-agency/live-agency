{
  "name": "@flair-agency/live-agency-platform-tiktok",
  "version": "0.1.0-m3.4",
  "description": "Declarative TikTok capability selection for LIVE Agency environments",
  "repository": {
    "type": "git",
    "url": "https://github.com/flair-agency/live-agency.git",
    "directory": "platforms/tiktok"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "README.md"
  ],
  "dependencies": {
    "@flair-agency/tiktok-web-provider": "1.1.1"
  },
  "peerDependencies": {
    "@flair-agency/provider-protocol": "1.0.0",
    "@flair-agency/private-files": "1.0.0"
  },
  "liveAgencyPlatform": {
    "schemaVersion": 1,
    "id": "tiktok",
    "bindings": {
      "creator-profile-observation-source/v2": {
        "contractVersion": "2",
        "dependencyPath": [
          {
            "packageName": "@flair-agency/tiktok-web-provider",
            "packageVersion": "1.1.1"
          }
        ],
        "bindingId": "creator-profile-observation"
      }
    },
    "skills": [
      {
        "id": "live-agency-creator-profile-record",
        "package": {
          "name": "@flair-agency/creator-profile-record",
          "version": "2.0.0-m3.4"
        },
        "status": "available",
        "requires": [
          "creator-profile-observation-source/v2",
          "creator-profile-datastore-read/v1",
          "creator-profile-datastore-write/v1"
        ]
      }
    ]
  }
}
