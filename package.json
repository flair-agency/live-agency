{
  "name": "live-agency-development",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "runtime",
    "skills/*",
    "providers/*",
    "mcp/*",
    "packages/*",
    "test/fixtures/providers/*",
    "test/fixtures/consumers/*"
  ],
  "dependencies": {
    "@flair-agency/backstage-provider": "1.4.0",
    "@flair-agency/google-drive-provider": "1.0.0",
    "@flair-agency/moneyforward-cloud-expense-provider": "1.5.0",
    "@flair-agency/tiktok-ios-provider": "1.2.0",
    "@flair-agency/tiktok-web-provider": "1.1.0",
    "@larksuite/cli": "1.0.93",
    "@flair-agency/lark-base-provider": "1.2.0",
    "@flair-agency/private-files": "1.0.0",
    "@flair-agency/provider-protocol": "1.0.0",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "scripts": {
    "test": "node tools/test-all.mjs",
    "test:skills": "node --test skills/*/test/*.mjs",
    "check:public": "node tools/check-public-content.mjs",
    "runtime:mcp:start": "node mcp/operations/src/server.mjs",
    "runtime:mcp:start:scouting": "node mcp/operations/src/creator-scouting-server.mjs",
    "runtime:mcp:start:scouting-write": "node mcp/operations/src/creator-scouting-write-server.mjs",
    "runtime:mcp:start:scouting-invitation-write": "node mcp/operations/src/creator-scouting-invitation-write-server.mjs",
    "runtime:mcp:start:scouting-profile-write": "node mcp/operations/src/creator-scouting-profile-write-server.mjs",
    "runtime:mcp:start:management": "node mcp/operations/src/creator-management-server.mjs",
    "runtime:mcp:start:intelligence": "node runtime/scripts/agency-intelligence-mcp-server.mjs",
    "runtime:test:m4i": "node --test mcp/operations/test/agency-intelligence-mcp.test.mjs mcp/operations/test/conversation-message-contracts.test.mjs providers/lark-chat/test/*.test.js runtime/scripts/agency-intelligence-mcp-runtime.test.mjs runtime/scripts/activate-v2-m4i-creator-networks-browser.test.mjs runtime/scripts/verify-v2-m4i-agency-intelligence-active.test.mjs runtime/scripts/m4i-phase3-conformance.test.mjs",
    "runtime:test:m2u-4e": "node --test runtime/scripts/creator-activity-sync-runner.test.mjs",
    "runtime:test:mcp": "node --test mcp/operations/test/*.test.mjs",
    "runtime:test:smoke": "node --test runtime/scripts/smoke-test.mjs",
    "runtime:test:backup-gates": "node --test skills/live-agency-data-recovery-test/test/lark-base-disaster-recovery-drill.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fixture/activity-pasted-source": "1.0.0",
    "@fixture/coin-purchase-instruction-provider": "1.0.0",
    "@fixture/expense-instruction-provider": "1.0.0",
    "@fixture/gift-history-source": "1.0.0",
    "@fixture/invitation-instruction-source": "1.0.0",
    "@fixture/invitation-observation-source": "1.0.0",
    "@fixture/live-history-instruction-source": "1.0.0",
    "@fixture/multi-binding-provider": "1.0.0",
    "@fixture/profile-instruction-source": "1.0.0",
    "@fixture/monthly-foundation-provider": "1.0.0",
    "@fixture/monthly-foundation-consumer": "1.0.0"
  }
}
